{
  "name": "recovery-ops",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd backend && .\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 0.0.0.0 --port 3001",
    "dev:web": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=frontend",
    "start:api": "cd backend && .\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 3001",
    "db:init": "cd backend && .\\.venv\\Scripts\\python.exe init_db.py",
    "db:seed": "cd backend && .\\.venv\\Scripts\\python.exe seed.py",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3"
  }
}
